# ---------------------------------------------------------------------------
# Website MTs Ma'arif Tieng — contoh konfigurasi lingkungan
# Salin ke .env.local untuk pengembangan: cp .env.example .env.local
# Jangan pernah commit .env.local (sudah masuk .gitignore).
# ---------------------------------------------------------------------------

# URL dasar situs (canonical, Open Graph, sitemap).
# Dev: http://localhost:3000
# Produksi: isi dengan domain .sch.id. Bila dikosongkan, situs otomatis
# memakai URL bawaan Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Turso (libSQL).
# Dev lokal: file:./.data/dev.db (tidak perlu token)
# Produksi:   libsql://<nama-db>.turso.io  + token dari dashboard Turso
TURSO_DATABASE_URL="file:./.data/dev.db"
TURSO_AUTH_TOKEN=""

# Rahasia Auth.js (sesi JWT). Buat dengan: openssl rand -base64 32
# WAJIB diganti saat produksi.
AUTH_SECRET="ganti-dengan-nilai-acak"

# Akun admin pertama. Dipakai oleh `npm run seed:admin`.
ADMIN_EMAIL="admin@sekolah.sch.id"
ADMIN_PASSWORD="ganti-password-ini"

# ---------------------------------------------------------------------------
# Telegram Bot API — penyimpanan gambar + notifikasi pesan kontak.
# Biarkan kosong untuk pengembangan: sistem otomatis memakai penyimpanan
# lokal (.data/media) sebagai pengganti, dan notifikasi hanya dicatat di log.
# Produksi: isi keduanya (grup privat, bot sudah jadi admin grup).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
